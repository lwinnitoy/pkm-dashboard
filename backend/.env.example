# Copy to .env and fill in. .env is git-ignored.

# Plaid credentials (dashboard.plaid.com -> Team Settings -> Keys)
PLAID_CLIENT_ID=your_client_id_here
PLAID_SECRET=your_sandbox_secret_here

# One of: sandbox | production
PLAID_ENV=sandbox

# Comma-separated country codes for Link (Canada + US)
PLAID_COUNTRY_CODES=US,CA

# Products requested at Link time (these filter which institutions appear in Link)
PLAID_PRODUCTS=transactions

# Consent-only products, captured if the institution supports them without filtering
# the institution list. Lets investment-heavy institutions (e.g. Wealthsimple) link
# and consent to investments data. Comma-separated; leave blank to disable.
PLAID_ADDITIONAL_CONSENTED_PRODUCTS=investments

# Database. SQLite for local dev; for a cloud DB use Postgres via the psycopg
# driver (note the +psycopg), e.g. Neon/Supabase:
#   DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# On Postgres the schema is migration-managed — run `alembic upgrade head` (see
# docs/database.md). SQLite creates its schema automatically on boot. Bare
# postgres://…/postgresql://… URLs are auto-normalized to the psycopg driver.
DATABASE_URL=sqlite:///./pkm.db

# Automatic Plaid sync cadence in hours (0 = disabled). Set e.g. 6 in an always-on
# hosted deployment; requires a Reserved VM / VPS (not a scale-to-zero service).
SYNC_INTERVAL_HOURS=0

# Fernet key for encrypting Plaid access_tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this secret and stable — rotating it makes existing stored tokens unreadable.
SECRET_ENCRYPTION_KEY=

# Frontend origin allowed by CORS
FRONTEND_ORIGIN=http://localhost:5173

# Single-user auth. Leave APP_PASSWORD blank for local dev (auth disabled). Set it
# in any hosted/exposed environment to require login — the API is otherwise open.
APP_PASSWORD=
# Secret used to sign login tokens. Defaults to SECRET_ENCRYPTION_KEY if blank;
# set a separate value to rotate auth tokens without touching encrypted data.
AUTH_SECRET=
# Login token lifetime in hours (default 720 = 30 days).
AUTH_TOKEN_TTL_HOURS=720
