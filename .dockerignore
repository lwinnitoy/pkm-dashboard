# Keep build contexts small and avoid leaking local state into images.
**/.git
**/.venv
**/venv
**/__pycache__
**/*.py[cod]
**/node_modules
frontend/dist
frontend/.vite
**/*.db
**/*.sqlite3
**/.env
.claude
docs
# Never ship local tooling output or real bank exports into an image.
.playwright-mcp
statements
**/download-transactions*.csv
