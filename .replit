# Replit config. Deploys as a single always-on process: the frontend is built to
# static files and served by FastAPI (see app/main.py), which also exposes the API.
#
# Deploy as a RESERVED VM (deploymentTarget = "gce") — the automatic-sync and daily
# snapshot jobs run in-process via APScheduler, so the app must stay always-on; an
# autoscale deployment would scale to zero and suspend them.
#
# Required Deployment Secrets (Deployments -> Secrets), NOT committed here:
#   SECRET_ENCRYPTION_KEY  (Fernet key)      APP_PASSWORD  (login password)
#   PLAID_CLIENT_ID  PLAID_SECRET  PLAID_ENV=production
#   SYNC_INTERVAL_HOURS=6                     (enables automatic sync)
# DATABASE_URL is provided automatically when you add Replit's PostgreSQL.

modules = ["python-3.11", "nodejs-20"]

# Workspace "Run" button: build the UI then serve everything on one port.
run = "cd frontend && npm install && VITE_API_BASE='' npm run build && cd ../backend && pip install -r requirements.txt && alembic upgrade head && python -m uvicorn app.main:app --host 0.0.0.0 --port 8080"

[env]
PYTHONUNBUFFERED = "1"

[deployment]
deploymentTarget = "gce"
build = ["sh", "-c", "cd frontend && npm ci && VITE_API_BASE='' npm run build && cd ../backend && pip install -r requirements.txt"]
run = ["sh", "-c", "cd backend && alembic upgrade head && python -m uvicorn app.main:app --host 0.0.0.0 --port 8080"]

[[ports]]
localPort = 8080
externalPort = 80
